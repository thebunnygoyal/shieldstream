{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/thumb/:path*", "destination": "/api/proxy/thumb/:path*" },
    { "source": "/media/:path*", "destination": "/api/proxy/media/:path*" },
    { "source": "/watch/:id", "destination": "/index.html" },
    { "source": "/unlock/:id", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" }
  ]
}
